        ],
        "expectation": {
          "expects": "absent",
          "object": "table \"Task\""
        }
      }
    ],
    "execute": [
      {
        "description": "create table \"Task\"",
        "sql": "CREATE TABLE \"public\".\"Task\" (\n  \"createdAt\" timestamptz(3) DEFAULT (now()) NOT NULL,\n  \"dateTime\" timestamptz(3) NOT NULL,\n  \"description\" text,\n  \"endTime\" timestamptz(3),\n  \"id\" SERIAL NOT NULL,\n  \"priority\" text,\n  \"status\" text DEFAULT 'open' NOT NULL,\n  \"title\" text NOT NULL,\n  \"updatedAt\" timestamptz(3) NOT NULL,\n  PRIMARY KEY (\"id\")\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"Task\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_class\" AS \"c\" WHERE (\"c\".\"oid\" = to_regclass($1) AND (\"c\".\"relkind\" = $2 OR \"c\".\"relkind\" = $3))) AS \"result\"",
        "params": [
          "\"public\".\"Task\"",
          "r",
          "p"
        ],
        "expectation": {
          "expects": "present",
          "object": "table \"Task\""
        }
