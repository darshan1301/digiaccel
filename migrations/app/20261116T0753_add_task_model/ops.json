    "id": "table.Task",
    "label": "Create table \"Task\"",
    "summary": "Creates table \"Task\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "Task"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"Task\" does not exist",
        "sql": "SELECT (to_regclass($1)) IS NULL AS \"result\"",
        "params": [
